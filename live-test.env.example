# Real mail account used for live checks against a real provider.
#
#   cp live-test.env.example live-test.env    (live-test.env is git-ignored)
#
# Only settings go here, never the password or tokens. The password lives in the
# system keychain and is read from there when a live check runs:
#
#   secret-tool store --label="Citusmail test account" service citusmail-test account you@example.com
#
# Live checks are read-only, except that tests which must write use only
# LIVE_TEST_FOLDER and send mail only to LIVE_EMAIL itself.

LIVE_EMAIL=you@example.com

# How the account signs in: "password" (default), "microsoft" for
# Outlook.com, Hotmail and Microsoft 365, or "google" for Gmail (its client
# secret goes in the keychain: service citusmail-test-oauth-client, account =
# the client ID). A Microsoft account needs no
# password and no server settings below (Microsoft's are used): the first
# live check opens the browser to sign in and keeps the tokens in the
# keychain (service citusmail-test-oauth).
#LIVE_SIGN_IN=microsoft
# The app registration's client ID (Microsoft: Application (client) ID;
# Google: ...apps.googleusercontent.com). Not a secret; see
# packaging/README.md.
#LIVE_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# IMAP: implicit TLS (usually port 993). Plain-text servers are refused.
LIVE_IMAP_HOST=mail.example.com
LIVE_IMAP_PORT=993

# SMTP submission: implicit TLS (usually port 465), or STARTTLS on 587.
LIVE_SMTP_HOST=mail.example.com
LIVE_SMTP_PORT=465

# The only folder live tests may create or change.
LIVE_TEST_FOLDER=CitusmailTest
