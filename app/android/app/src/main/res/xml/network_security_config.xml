<?xml version="1.0" encoding="utf-8"?>
<!-- Block all plain-text traffic and trust only the system certificate
     store (never user-installed CAs, which can be used to intercept TLS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
