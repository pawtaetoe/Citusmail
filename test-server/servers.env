# Test mail servers started by test-server/fmailtest.
# Sourced by bash and parsed by the seeder and integration tests, so keep it
# to simple KEY=value lines. All ports are bound to 127.0.0.1 only.

TEST_DOMAIN=fmail.test
# Each user's password is "<user>-test-password" (public test values).
TEST_USERS="alice bob carol"

# secure: TLS required, full modern IMAP
SECURE_IMAP_PORT=10143
SECURE_IMAPS_PORT=10993
SECURE_SUBMISSION_PORT=10587
SECURE_SUBMISSIONS_PORT=10465
SECURE_SIEVE_PORT=14190

# limited: TLS required, no CONDSTORE/QRESYNC/MOVE
LIMITED_IMAP_PORT=12143
LIMITED_IMAPS_PORT=12993
LIMITED_SUBMISSION_PORT=12587
LIMITED_SUBMISSIONS_PORT=12465

# plain: no TLS at all (the app must refuse it)
PLAIN_IMAP_PORT=11143
PLAIN_SUBMISSION_PORT=11587
